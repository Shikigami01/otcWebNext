{
  "name": "otc-web-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write src/",
    "cm": "git-cz",
    "tsm": "typed-scss-modules src --watch --implementation sass --nameFormat none --exportType default --aliasPrefixes.@ src/",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-h5-audio-player": "^3.10.2",
    "the-new-css-reset": "^1.11.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/nextjs": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.6",
    "git-cz": "^4.9.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "sass": "^1.108.0",
    "storybook": "^10.6.6",
    "stylelint": "^15.11.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^4.6.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "tailwindcss": "^3.4.19",
    "typed-scss-modules": "^7.1.4",
    "typescript": "^5.9.3"
  }
}
